<Window x:Class="PaperMasterWin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="论文智作大师 (PaperMaster) - Windows版"
        Height="800" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">

    <Window.Resources>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#333"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E3F2FD"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#BBDEFB"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左侧导航栏 -->
        <Border Grid.Column="0" Background="#FAFAFA" BorderBrush="#E0E0E0" BorderThickness="0,0,1,0">
            <StackPanel Margin="10">
                <TextBlock Text="📝 论文智作大师" 
                           FontSize="16" FontWeight="Bold" 
                           Margin="0,15,0,15" Foreground="#1976D2"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="Step 1" FontWeight="Bold" Margin="0,5,0,2" Foreground="#666"/>
                <Button x:Name="BtnStep1" Content="选题与参数设置" 
                        Style="{StaticResource NavButton}" 
                        Tag="Step1" Click="StepTab_Click"/>

                <TextBlock Text="Step 2" FontWeight="Bold" Margin="0,10,0,2" Foreground="#666"/>
                <Button x:Name="BtnStep2" Content="论文大纲" 
                        Style="{StaticResource NavButton}" 
                        Tag="Step2" Click="StepTab_Click"/>

                <TextBlock Text="Step 3" FontWeight="Bold" Margin="0,10,0,2" Foreground="#666"/>
                <Button x:Name="BtnStep3" Content="开题报告" 
                        Style="{StaticResource NavButton}" 
                        Tag="Step3" Click="StepTab_Click"/>

                <TextBlock Text="Step 4" FontWeight="Bold" Margin="0,10,0,2" Foreground="#666"/>
                <Button x:Name="BtnStep4" Content="论文正文" 
                        Style="{StaticResource NavButton}" 
                        Tag="Step4" Click="StepTab_Click"/>

                <TextBlock Text="Step 5" FontWeight="Bold" Margin="0,10,0,2" Foreground="#666"/>
                <Button x:Name="BtnStep5" Content="答辩演讲稿 & PPT" 
                        Style="{StaticResource NavButton}" 
                        Tag="Step5" Click="StepTab_Click"/>

                <Separator Margin="0,20,0,0"/>

                <Button x:Name="BtnConfig" Content="⚙ 配置" 
                        Style="{StaticResource NavButton}" 
                        Click="BtnConfig_Click" Margin="0,10,0,5"/>
                <Button x:Name="BtnHistory" Content="📂 历史记录" 
                        Style="{StaticResource NavButton}" 
                        Click="BtnHistory_Click" Margin="0,0,0,5"/>
                <Button x:Name="BtnAbout" Content="ℹ 关于" 
                        Style="{StaticResource NavButton}" 
                        Click="BtnAbout_Click" Margin="0,0,0,5"/>
            </StackPanel>
        </Border>

        <!-- 右侧主内容区域 -->
        <Grid Grid.Column="1">
            <!-- Step 1: 选题与参数设置 -->
            <StackPanel x:Name="PanelStep1" Visibility="Visible" Margin="20">
                <TextBlock Text="Step 1: 选题与参数设置" FontSize="20" FontWeight="Bold" Margin="0,10,0,20" Foreground="#1976D2"/>

                <Label Content="论文题目" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBox x:Name="EtTitle" Height="40" Margin="0,0,0,15" Padding="5" FontSize="14"/>

                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <Label Content="论文层次" FontWeight="Bold"/>
                        <ComboBox x:Name="SpLevel" Height="35" Padding="5">
                            <ComboBoxItem Content="本科毕业论文" IsSelected="True"/>
                            <ComboBoxItem Content="硕士学位论文"/>
                            <ComboBoxItem Content="专科毕业设计/论文"/>
                            <ComboBoxItem Content="博士学位论文"/>
                            <ComboBoxItem Content="期末课程论文"/>
                            <ComboBoxItem Content="中职/高职毕业报告"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                        <Label Content="学科门类" FontWeight="Bold"/>
                        <ComboBox x:Name="SpDiscipline" Height="35" Padding="5" SelectedIndex="0">
                            <ComboBoxItem Content="工学 (计算机/电子信息/土木/机械/电气/自动化等)" IsSelected="True"/>
                            <ComboBoxItem Content="管理学 (工商管理/财务管理/电子商务/物流/信息管理等)"/>
                            <ComboBoxItem Content="经济学 (金融学/国际经济与贸易/应用经济学等)"/>
                            <ComboBoxItem Content="理学 (数学/物理/化学/生物技术等)"/>
                            <ComboBoxItem Content="法学 (法学理论/宪法行政法/民商法/社会学等)"/>
                            <ComboBoxItem Content="教育学 (学前教育/教育技术/体育教育/课程教学论等)"/>
                            <ComboBoxItem Content="文学 (汉语言文学/英语/翻译/新闻传播等)"/>
                            <ComboBoxItem Content="艺术学 (视觉传达/环境设计/产品设计/数字媒体艺术等)"/>
                            <ComboBoxItem Content="医学 (临床/护理/药学/中医学/预防医学等)"/>
                            <ComboBoxItem Content="农学 (农学/植物保护/园艺/林学等)"/>
                            <ComboBoxItem Content="哲学 (哲学/逻辑学/伦理学/宗教学等)"/>
                            <ComboBoxItem Content="历史学 (中国史/世界史/考古学等)"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <Label Content="专业方向" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBox x:Name="EtMajor" Height="35" Margin="0,0,0,15" Padding="5" FontSize="14"/>

                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <Label Content="目录级别" FontWeight="Bold"/>
                        <ComboBox x:Name="SpOutlineLevel" Height="35" Padding="5" SelectedIndex="0">
                            <ComboBoxItem Content="三级目录 (推荐)" IsSelected="True"/>
                            <ComboBoxItem Content="二级目录"/>
                            <ComboBoxItem Content="四级目录"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="10,0,10,0">
                        <Label Content="字数要求" FontWeight="Bold"/>
                        <ComboBox x:Name="SpWordCount" Height="35" Padding="5" SelectedIndex="0">
                            <ComboBoxItem Content="8,000 - 10,000 字 (标准本科)" IsSelected="True"/>
                            <ComboBoxItem Content="12,000 - 15,000 字 (优秀本科/专硕)"/>
                            <ComboBoxItem Content="5,000 - 8,000 字 (专科/期末)"/>
                            <ComboBoxItem Content="20,000 - 30,000 字 (学硕/硕士)"/>
                            <ComboBoxItem Content="3,000 - 5,000 字 (简版短篇)"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="10,0,0,0">
                        <Label Content="预设模板" FontWeight="Bold"/>
                        <ComboBox x:Name="SpTemplate" Height="35" Padding="5" SelectedIndex="0">
                            <ComboBoxItem Content="标准学术实证/工程设计模板" IsSelected="True"/>
                            <ComboBoxItem Content="实证分析与计量统计模板"/>
                            <ComboBoxItem Content="案例分析研究模板"/>
                            <ComboBoxItem Content="实验性科技研究模板"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <Button Content="🚀 生成论文大纲" x:Name="BtnGenerateOutline" 
                        Height="45" FontSize="16" FontWeight="Bold"
                        Background="#1976D2" Foreground="White"
                        Click="BtnGenerateOutline_Click" Margin="0,10,0,0"/>
            </StackPanel>

            <!-- Step 2: 论文大纲 -->
            <StackPanel x:Name="PanelStep2" Visibility="Collapsed" Margin="20">
                <TextBlock Text="Step 2: 论文大纲" FontSize="20" FontWeight="Bold" Margin="0,10,0,20" Foreground="#1976D2"/>
                <TextBox x:Name="EtOutlineContent" Height="400" Padding="10" FontSize="14" 
                         TextWrapping="Wrap" AcceptsReturn="True" 
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         Margin="0,0,0,15"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="🔄 重新生成大纲" x:Name="BtnRegenerateOutline" 
                            Height="40" Margin="0,0,10,0" Click="BtnRegenerateOutline_Click"/>
                    <Button Content="📥 导出大纲 DOCX" x:Name="BtnDownloadOutline" 
                            Height="40" Margin="0,0,10,0" Click="BtnDownloadOutline_Click"/>
                    <Button Content="✅ 保存并进入下一步" x:Name="BtnSaveOutlineNext" 
                            Height="40" Background="#1976D2" Foreground="White"
                            Click="BtnSaveOutlineNext_Click" Width="160"/>
                </StackPanel>
            </StackPanel>

            <!-- Step 3: 开题报告 -->
            <StackPanel x:Name="PanelStep3" Visibility="Collapsed" Margin="20">
                <TextBlock Text="Step 3: 开题报告" FontSize="20" FontWeight="Bold" Margin="0,10,0,20" Foreground="#1976D2"/>
                <TextBox x:Name="EtProposalContent" Height="400" Padding="10" FontSize="14" 
                         TextWrapping="Wrap" AcceptsReturn="True"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         Margin="0,0,0,15"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="📋 复制内容" x:Name="BtnCopyProposal" 
                            Height="40" Margin="0,0,10,0" Click="BtnCopyProposal_Click"/>
                    <Button Content="📥 导出 DOCX" x:Name="BtnDownloadProposal" 
                            Height="40" Margin="0,0,10,0" Click="BtnDownloadProposal_Click"/>
                    <Button Content="🚀 生成开题报告" x:Name="BtnGenerateProposal" 
                            Height="40" Margin="0,0,10,0" Background="#1976D2" Foreground="White"
                            Click="BtnGenerateProposal_Click"/>
                    <Button Content="✅ 保存并进入下一步" x:Name="BtnSaveProposalNext" 
                            Height="40" Background="#1976D2" Foreground="White"
                            Click="BtnSaveProposalNext_Click" Width="160"/>
                </StackPanel>
            </StackPanel>

            <!-- Step 4: 论文正文 -->
            <StackPanel x:Name="PanelStep4" Visibility="Collapsed" Margin="20">
                <TextBlock Text="Step 4: 论文正文" FontSize="20" FontWeight="Bold" Margin="0,10,0,20" Foreground="#1976D2"/>
                <TextBox x:Name="EtPaperContent" Height="400" Padding="10" FontSize="14" 
                         TextWrapping="Wrap" AcceptsReturn="True"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         Margin="0,0,0,15"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="📋 复制" x:Name="BtnCopyPaper" Height="40" Margin="0,0,5,0" Click="BtnCopyPaper_Click"/>
                    <Button Content="🔬 降低AI率" x:Name="BtnReduceAigc" Height="40" Margin="0,0,5,0" Click="BtnReduceAigc_Click"/>
                    <Button Content="📥 导出 DOCX" x:Name="BtnDownloadPaper" Height="40" Margin="0,0,5,0" Click="BtnDownloadPaper_Click"/>
                    <Button Content="🚀 生成正文" x:Name="BtnGeneratePaper" Height="40" Margin="0,0,5,0" Background="#1976D2" Foreground="White" Click="BtnGeneratePaper_Click"/>
                    <Button Content="✅ 保存并进入下一步" x:Name="BtnSavePaperNext" 
                            Height="40" Background="#1976D2" Foreground="White"
                            Click="BtnSavePaperNext_Click" Width="160"/>
                </StackPanel>
            </StackPanel>

            <!-- Step 5: 答辩演讲稿 & PPT -->
            <StackPanel x:Name="PanelStep5" Visibility="Collapsed" Margin="20">
                <TextBlock Text="Step 5: 答辩演讲稿 & PPT大纲" FontSize="20" FontWeight="Bold" Margin="0,10,0,20" Foreground="#1976D2"/>
                
                <TabControl Margin="0,0,0,10">
                    <TabItem Header="🎤 答辩演讲稿">
                        <TextBox x:Name="EtDefenseSpeech" Height="300" Padding="10" FontSize="14" 
                                 TextWrapping="Wrap" AcceptsReturn="True"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                            <Button Content="📋 复制" x:Name="BtnCopyDefense" Height="40" Margin="0,0,10,0" Click="BtnCopyDefense_Click"/>
                            <Button Content="📥 导出 DOCX" x:Name="BtnDownloadDefense" Height="40" Margin="0,0,10,0" Click="BtnDownloadDefense_Click"/>
                            <Button Content="🚀 生成演讲稿" x:Name="BtnGenerateDefense" Height="40" Background="#1976D2" Foreground="White" Click="BtnGenerateDefense_Click"/>
                        </StackPanel>
                    </TabItem>
                    <TabItem Header="📊 PPT大纲">
                        <TextBox x:Name="EtPptContent" Height="300" Padding="10" FontSize="14" 
                                 TextWrapping="Wrap" AcceptsReturn="True"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                            <Button Content="📋 复制" x:Name="BtnCopyPpt" Height="40" Margin="0,0,10,0" Click="BtnCopyPpt_Click"/>
                            <Button Content="🚀 生成PPT大纲" x:Name="BtnGeneratePpt" Height="40" Background="#1976D2" Foreground="White" Click="BtnGeneratePpt_Click"/>
                        </StackPanel>
                    </TabItem>
                </TabControl>
            </StackPanel>

            <!-- 加载中遮罩 -->
            <Border x:Name="LoadingOverlay" Visibility="Collapsed" 
                    Background="rgba(0,0,0,0.5)" Grid.Column="1"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="200" Height="10" Margin="0,0,0,15"/>
                    <TextBlock x:Name="TvLoadingText" Text="正在生成中..." FontSize="16" 
                               Foreground="White" TextAlignment="Center"/>
                    <Button x:Name="BtnManualStop" Content="⏹ 手动停止" 
                            Height="35" Width="120" Margin="0,15,0,0"
                            Click="BtnManualStop_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
