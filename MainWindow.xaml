<Window x:Class="PaperMasterWin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="📝 论文智作大师 - PaperMaster"
        Height="800" Width="1200"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="📝 论文智作大师 (PaperMaster)" FontSize="24" FontWeight="Bold" 
                       HorizontalAlignment="Center" Margin="0,0,0,10"/>
            
            <!-- Input fields -->
            <StackPanel Margin="0,0,0,10">
                <TextBlock Text="论文题目:" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBox x:Name="TitleInput" Height="30" Margin="0,0,0,10"/>
                
                <TextBlock Text="研究方向:" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBox x:Name="ResearchInput" Height="30" Margin="0,0,0,10"/>
            </StackPanel>

            <!-- Steps buttons -->
            <WrapPanel Margin="0,0,0,10">
                <Button x:Name="BtnStep1" Content="📋 任务书" Width="120" Margin="0,0,5,5"
                        Click="BtnStep1_Click"/>
                <Button x:Name="BtnStep2" Content="📖 开题报告" Width="120" Margin="0,0,5,5"
                        Click="BtnStep2_Click"/>
                <Button x:Name="BtnStep3" Content="📚 文献综述" Width="120" Margin="0,0,5,5"
                        Click="BtnStep3_Click"/>
                <Button x:Name="BtnStep4" Content="📝 论文正文" Width="120" Margin="0,0,5,5"
                        Click="BtnStep4_Click"/>
                <Button x:Name="BtnStep5" Content="🎤 答辩PPT" Width="120" Margin="0,0,5,5"
                        Click="BtnStep5_Click"/>
                <Button x:Name="BtnConfig" Content="⚙️ 配置" Width="80" Margin="0,0,5,5"
                        Click="BtnConfig_Click"/>
                <Button x:Name="BtnSave" Content="💾 保存Word" Width="80"
                        Click="BtnSaveDocx_Click"/>
            </WrapPanel>
        </StackPanel>

        <!-- Output area -->
        <TabControl Grid.Row="1" x:Name="OutputTabs">
            <TabItem Header="📋 任务书">
                <TextBox x:Name="EtTaskbook" Height="400" Padding="10" FontSize="14" 
                         TextWrapping="Wrap" IsReadOnly="True"/>
            </TabItem>
            <TabItem Header="📖 开题报告">
                <TextBox x:Name="EtProposal" Height="400" Padding="10" FontSize="14" 
                         TextWrapping="Wrap" IsReadOnly="True"/>
            </TabItem>
            <TabItem Header="📚 文献综述">
                <TextBox x:Name="EtLitReview" Height="400" Padding="10" FontSize="14" 
                         TextWrapping="Wrap" IsReadOnly="True"/>
            </TabItem>
            <TabItem Header="📝 论文正文">
                <TextBox x:Name="EtPaperContent" Height="400" Padding="10" FontSize="14" 
                         TextWrapping="Wrap" IsReadOnly="True"/>
            </TabItem>
            <TabItem Header="🎤 答辩PPT">
                <TextBox x:Name="EtDefensePpt" Height="400" Padding="10" FontSize="14" 
                         TextWrapping="Wrap" IsReadOnly="True"/>
            </TabItem>
        </TabControl>

        <!-- Footer -->
        <StackPanel Grid.Row="2" Margin="0,10,0,0" 
                    HorizontalAlignment="Center">
            <TextBlock Text="AI API: aiapi.whsunshine.link | WeChat: ai_dxlw" 
                       FontSize="12" Foreground="Gray"/>
        </StackPanel>
    </Grid>
</Window>