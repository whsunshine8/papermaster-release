<Window x:Class="PaperMasterWin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="📝 论文智作大师 - PaperMaster (Windows 原生专业版)"
        Height="860" Width="1280" MinWidth="1050" MinHeight="700"
        WindowStartupLocation="CenterScreen" Background="#F8FAFC">
    <Grid>
        <Grid.RowDefinitions>
            <!-- Top bar -->
            <RowDefinition Height="Auto"/>
            <!-- Main Content Area -->
            <RowDefinition Height="*"/>
            <!-- Bottom Status / Promotion -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. Top Header & Nav -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="16,12,16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📄" FontSize="24" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="论文智作大师" FontSize="18" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center"/>
                    <Border Background="#EEF2FF" CornerRadius="4" Padding="6,2,6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Windows v1.1.2" FontSize="11" FontWeight="SemiBold" Foreground="#4F46E5"/>
                    </Border>
                </StackPanel>

                <!-- Top Action Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnHistory" Content="🕒 历史记录" Height="32" Padding="12,0,12,0" Margin="0,0,8,0"
                            Background="#F1F5F9" Foreground="#334155" BorderBrush="#CBD5E1" Cursor="Hand" Click="BtnHistory_Click"/>
                    <Button x:Name="BtnCheckUpdate" Content="🚀 检查更新" Height="32" Padding="12,0,12,0" Margin="0,0,8,0"
                            Background="#F1F5F9" Foreground="#334155" BorderBrush="#CBD5E1" Cursor="Hand" Click="BtnCheckUpdate_Click"/>
                    <Button x:Name="BtnConfig" Content="⚙️ 系统配置" Height="32" Padding="12,0,12,0"
                            Background="#2563EB" Foreground="#FFFFFF" BorderBrush="#2563EB" Cursor="Hand" Click="BtnConfig_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Main Content Tabs -->
        <TabControl Grid.Row="1" x:Name="MainTabs" Margin="16,12,16,12" Background="#FFFFFF" BorderBrush="#E2E8F0">
            <!-- TAB 1: 1.基本设定 -->
            <TabItem Header="  1. 基本设定  " FontSize="14" FontWeight="SemiBold">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                    <StackPanel MaxWidth="900" HorizontalAlignment="Left">
                        <TextBlock Text="🎯 论文核心信息与学术约束设定" FontSize="18" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,16"/>

                        <!-- 论文题目 -->
                        <TextBlock Text="论文题目 (必填):" FontWeight="SemiBold" Margin="0,0,0,6" Foreground="#334155"/>
                        <TextBox x:Name="TbTitle" Height="36" FontSize="14" Padding="8,6,8,6" Margin="0,0,0,14"
                                 Text="基于深度强化学习的机器人运动控制与路径规划系统设计"/>

                        <!-- 论文层次 & 学科门类 -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="论文层次:" FontWeight="SemiBold" Margin="0,0,0,6" Foreground="#334155"/>
                                <ComboBox x:Name="CbLevel" Height="36" FontSize="13" VerticalContentAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="学科门类:" FontWeight="SemiBold" Margin="0,0,0,6" Foreground="#334155"/>
                                <ComboBox x:Name="CbDiscipline" Height="36" FontSize="13" VerticalContentAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <!-- 专业 & 目录级别 -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="所学专业:" FontWeight="SemiBold" Margin="0,0,0,6" Foreground="#334155"/>
                                <TextBox x:Name="TbMajor" Height="36" FontSize="13" Padding="8,6,8,6" Text="计算机科学与技术 / 机器人工程"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="目录级别:" FontWeight="SemiBold" Margin="0,0,0,6" Foreground="#334155"/>
                                <ComboBox x:Name="CbOutlineLevel" Height="36" FontSize="13" VerticalContentAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <!-- 论文字数 & 结构模板 -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="论文字数 (纯正文目标):" FontWeight="SemiBold" Margin="0,0,0,6" Foreground="#334155"/>
                                <ComboBox x:Name="CbWordCount" Height="36" FontSize="13" VerticalContentAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="结构模板预设:" FontWeight="SemiBold" Margin="0,0,0,6" Foreground="#334155"/>
                                <ComboBox x:Name="CbTemplate" Height="36" FontSize="13" VerticalContentAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <!-- 操作按钮 -->
                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button x:Name="BtnGenerateOutline" Content="⚡ 开始规划高规范大纲" Height="42" Padding="24,0,24,0"
                                    Background="#2563EB" Foreground="#FFFFFF" FontWeight="Bold" FontSize="14"
                                    BorderBrush="#2563EB" Cursor="Hand" Click="BtnGenerateOutline_Click"/>
                            <Button x:Name="BtnResetProject" Content="🔄 新建重置" Height="42" Padding="16,0,16,0" Margin="12,0,0,0"
                                    Background="#F1F5F9" Foreground="#475569" BorderBrush="#CBD5E1" Cursor="Hand" Click="BtnResetProject_Click"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 2: 2.大纲规划与编辑 -->
            <TabItem Header="  2. 大纲规划与编辑  " FontSize="14" FontWeight="SemiBold">
                <Border Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                        <Button x:Name="BtnRegenerateOutline" Content="🔄 重新生成大纲" Height="34" Padding="14,0,14,0"
                                Background="#F1F5F9" Foreground="#334155" BorderBrush="#CBD5E1" Margin="0,0,10,0" Click="BtnRegenerateOutline_Click"/>
                        <Button x:Name="BtnExportOutlineDocx" Content="💾 导出大纲为 Word" Height="34" Padding="14,0,14,0"
                                Background="#ECFDF5" Foreground="#059669" BorderBrush="#A7F3D0" Margin="0,0,10,0" Click="BtnExportOutlineDocx_Click"/>
                        <Button x:Name="BtnNextToProposal" Content="➡️ 保存大纲并进入开题报告" Height="34" Padding="16,0,16,0"
                                Background="#4F46E5" Foreground="#FFFFFF" BorderBrush="#4F46E5" FontWeight="Bold" Click="BtnNextToProposal_Click"/>
                    </StackPanel>
                    <TextBox Grid.Row="1" x:Name="TbOutline" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             FontSize="14" FontFamily="Consolas, Microsoft YaHei" Padding="12" BorderBrush="#CBD5E1"/>
                </Grid>
                </Border>
                </TabItem>

            <!-- TAB 3: 3.开题报告 -->
            <TabItem Header="  3. 开题报告  " FontSize="14" FontWeight="SemiBold">
                <Border Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                        <Button x:Name="BtnGenerateProposal" Content="⚡ 生成/更新开题报告" Height="34" Padding="14,0,14,0"
                                Background="#2563EB" Foreground="#FFFFFF" BorderBrush="#2563EB" FontWeight="Bold" Margin="0,0,10,0" Click="BtnGenerateProposal_Click"/>
                        <Button x:Name="BtnExportProposalDocx" Content="💾 导出开题报告 Word" Height="34" Padding="14,0,14,0"
                                Background="#ECFDF5" Foreground="#059669" BorderBrush="#A7F3D0" Margin="0,0,10,0" Click="BtnExportProposalDocx_Click"/>
                        <Button x:Name="BtnNextToPaper" Content="➡️ 进入正文撰写流水线" Height="34" Padding="16,0,16,0"
                                Background="#4F46E5" Foreground="#FFFFFF" BorderBrush="#4F46E5" FontWeight="Bold" Click="BtnNextToPaper_Click"/>
                    </StackPanel>
                    <TextBox Grid.Row="1" x:Name="TbProposal" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             FontSize="14" FontFamily="Microsoft YaHei" Padding="12" BorderBrush="#CBD5E1"/>
                </Grid>
                </Border>
                </TabItem>

            <!-- TAB 4: 4.论文正文 (分章节流水线) -->
            <TabItem Header="  4. 论文正文 (全篇长文)  " FontSize="14" FontWeight="SemiBold">
                <Border Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                    <WrapPanel Grid.Row="0" Margin="0,0,0,12">
                        <Button x:Name="BtnGeneratePaper" Content="🚀 开始分章节深度流水线撰写" Height="34" Padding="16,0,16,0"
                                Background="#2563EB" Foreground="#FFFFFF" BorderBrush="#2563EB" FontWeight="Bold" Margin="0,0,10,6" Click="BtnGeneratePaper_Click"/>
                        <Button x:Name="BtnReduceAigc" Content="🛡️ 深度去AI味 / 降低查重率" Height="34" Padding="14,0,14,0"
                                Background="#FEF3C7" Foreground="#B45309" BorderBrush="#FDE68A" FontWeight="SemiBold" Margin="0,0,10,6" Click="BtnReduceAigc_Click"/>
                        <Button x:Name="BtnExportPaperDocx" Content="💾 导出完整论文 Word (.docx)" Height="34" Padding="16,0,16,0"
                                Background="#ECFDF5" Foreground="#059669" BorderBrush="#A7F3D0" FontWeight="Bold" Margin="0,0,10,6" Click="BtnExportPaperDocx_Click"/>
                        <Button x:Name="BtnNextToDefense" Content="➡️ 进入答辩与PPT大纲" Height="34" Padding="14,0,14,0"
                                Background="#F1F5F9" Foreground="#334155" BorderBrush="#CBD5E1" Margin="0,0,10,6" Click="BtnNextToDefense_Click"/>
                    </WrapPanel>
                    <TextBox Grid.Row="1" x:Name="TbPaper" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             FontSize="14" FontFamily="SimSun, Times New Roman" Padding="14" BorderBrush="#CBD5E1"/>
                </Grid>
                </Border>
                </TabItem>

            <!-- TAB 5: 5.答辩书与PPT -->
            <TabItem Header="  5. 答辩自述与PPT  " FontSize="14" FontWeight="SemiBold">
                <Border Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                        <Button x:Name="BtnGenerateDefense" Content="🎤 生成答辩演讲自述稿" Height="34" Padding="14,0,14,0"
                                Background="#2563EB" Foreground="#FFFFFF" BorderBrush="#2563EB" Margin="0,0,10,0" Click="BtnGenerateDefense_Click"/>
                        <Button x:Name="BtnGeneratePpt" Content="📊 生成标准 Markdown 答辩PPT" Height="34" Padding="14,0,14,0"
                                Background="#7C3AED" Foreground="#FFFFFF" BorderBrush="#7C3AED" Margin="0,0,10,0" Click="BtnGeneratePpt_Click"/>
                        <Button x:Name="BtnExportDefenseDocx" Content="💾 导出答辩演讲稿 Word" Height="34" Padding="14,0,14,0"
                                Background="#ECFDF5" Foreground="#059669" BorderBrush="#A7F3D0" Margin="0,0,10,0" Click="BtnExportDefenseDocx_Click"/>
                        <Button x:Name="BtnExportPptDocx" Content="💾 导出PPT设计大纲 Word" Height="34" Padding="14,0,14,0"
                                Background="#ECFDF5" Foreground="#059669" BorderBrush="#A7F3D0" Margin="0,0,10,0" Click="BtnExportPptDocx_Click"/>
                    </StackPanel>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 左侧：答辩发言稿 -->
                        <GroupBox Grid.Column="0" Header="🎤 答辩自述稿与高频专家提问预案" BorderBrush="#CBD5E1" Padding="8">
                            <TextBox x:Name="TbDefense" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                     FontSize="13" FontFamily="Microsoft YaHei" Padding="8" BorderThickness="0"/>
                        </GroupBox>

                        <!-- 右侧：PPT大纲 -->
                        <GroupBox Grid.Column="2" Header="📊 标准 Markdown 幻灯片大纲 (支持导入 Gamma/Marp)" BorderBrush="#CBD5E1" Padding="8">
                            <TextBox x:Name="TbPpt" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                     FontSize="13" FontFamily="Consolas, Microsoft YaHei" Padding="8" BorderThickness="0"/>
                        </GroupBox>
                    </Grid>
                </Grid>
                </Border>
                </TabItem>
        </TabControl>

        <!-- 3. Bottom Status Bar & Promotion -->
        <Border Grid.Row="2" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="16,8,16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="TbStatusBar" Text="就绪。请在基本设定中输入题目并开始规划大纲。"
                           VerticalAlignment="Center" Foreground="#475569" FontSize="13"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🔗 AI API: aiapi.whsunshine.link" Margin="0,0,16,0" Foreground="#64748B" FontSize="12"/>
                    <TextBlock Text="💬 客服微信: ai_dxlw" Margin="0,0,16,0" Foreground="#059669" FontWeight="SemiBold" FontSize="12"/>
                    <TextBlock Text="🛒 闲鱼官方自动发卡店" Foreground="#EA580C" FontWeight="SemiBold" FontSize="12"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
